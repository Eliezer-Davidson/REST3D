+# Deferred layout post-optimization runner (12 GB enablement, 2026-08-12).
+#
+# Counterpart to the SAM3D_DEFER_LAYOUT_POSTOPT_DIR capture mode in
+# inference_pipeline_pointmap.py: a bundle file holds the EXACT inputs the
+# in-loop call to InferencePipelinePointMap.run_post_optimization_GS would
+# have received; this module replays that call after the caller has released
+# the multi-GB model stack, so the optimization (which needs only ~1-2 GB)
+# never co-resides with the models. The math is identical by construction:
+# same function, same inputs, and layout_post_optimization_method_GS seeds
+# its own RNG (seed=100), so replays are deterministic.
+"""Run a captured layout post-opt bundle standalone."""
+import types
+
+import torch
+
+from sam3d_objects.pipeline.inference_pipeline_pointmap import InferencePipelinePointMap
+from sam3d_objects.pipeline.inference_utils import layout_post_optimization_method_GS
+
+
+def run_deferred_postopt(bundle_path: str, device: str | None = None) -> dict:
+    """Load a capture bundle and run the deferred GS layout post-optimization.
+
+    Returns run_post_optimization_GS's dict verbatim:
+    {rotation, translation, scale, iou, iou_before_optim, optim_accepted}.
+    """
+    if device is None:
+        device = "cuda" if torch.cuda.is_available() else "cpu"
+    bundle = torch.load(bundle_path, map_location=device, weights_only=False)
+
+    # run_post_optimization_GS only touches self.device, self.refine_scale and
+    # self.layout_post_optimization_method_GS -- a shim stands in for the
+    # pipeline so no model ever loads here.
+    shim = types.SimpleNamespace(
+        device=torch.device(device),
+        layout_post_optimization_method_GS=layout_post_optimization_method_GS,
+        refine_scale=lambda s: InferencePipelinePointMap.refine_scale(None, s),
+    )
+    return InferencePipelinePointMap.run_post_optimization_GS(
+        shim,
+        bundle["gs"],
+        bundle["intrinsics"],
+        bundle["pose"],
+        bundle["layout_input"],
+        backend=bundle.get("backend", "gsplat"),
+    )
