 from safetensors.torch import load_file
 
 
+def _rest3d_offload(pipeline, keep):
+    """REST3D low-VRAM helper. Enabled only when REST3D_CPU_OFFLOAD=1.
+
+    Upstream requires >=32GB VRAM because every model in ``pipeline.models`` stays
+    resident on the GPU for the whole run. This pages the models not needed by the
+    current phase out to system RAM and pages the needed ones back in, trading PCIe
+    transfer time for VRAM. Moving a tensor between devices does not change its
+    values, so this is numerically lossless (unlike casting weights to fp16).
+
+    No-op when the env var is unset, so stock behaviour is unchanged.
+    """
+    if os.environ.get("REST3D_CPU_OFFLOAD") != "1":
+        return
+    models = getattr(pipeline, "models", None)
+    if models is None:
+        return
+    keep = set(keep)
+    device = getattr(pipeline, "device", "cuda")
+    to_gpu, to_cpu = [], []
+    for name, module in models.items():
+        # entries can be None (optional decoders, e.g. slat_decoder_rf) or parameterless
+        if module is None or not hasattr(module, "parameters"):
+            continue
+        param = next(module.parameters(), None)
+        if param is None:
+            continue
+        on_gpu = param.device.type == "cuda"
+        if name in keep and not on_gpu:
+            module.to(device)
+            to_gpu.append(name)
+        elif name not in keep and on_gpu:
+            module.to("cpu")
+            to_cpu.append(name)
+    # Auxiliary modules live outside `models` -- condition_embedders is a plain dict, and
+    # pose_decoder is a bare attribute -- so the loop above never sees them. They are small
+    # and used by nearly every phase, so keep them permanently GPU-resident; otherwise the
+    # load-time offload strands them on CPU and forward() raises a device mismatch.
+    aux = []
+    embedders = getattr(pipeline, "condition_embedders", None)
+    if isinstance(embedders, dict):
+        aux.extend(embedders.values())
+    elif embedders is not None:
+        aux.append(embedders)
+    pose_decoder = getattr(pipeline, "pose_decoder", None)
+    if pose_decoder is not None:
+        aux.append(pose_decoder)
+    for module in aux:
+        if module is None or not hasattr(module, "parameters"):
+            continue
+        param = next(module.parameters(), None)
+        if param is not None and param.device.type != "cuda":
+            module.to(device)
+            to_gpu.append(type(module).__name__)
+
+    if to_gpu or to_cpu:
+        torch.cuda.empty_cache()
+        logger.info(f"[REST3D offload] ->GPU {to_gpu} | ->CPU {to_cpu}")
+
+
+def _rest3d_move_aux(pipeline, to_gpu):
+    """REST3D low-VRAM helper (REST3D_OFFLOAD_EMBEDDER=1). Page the modules that are idle
+    during mesh decode -- the two generators + ss_encoder (the big ~5.4GB chunk) and the
+    aux modules (condition_embedders + pose_decoder) -- between GPU and CPU.
+
+    This differs from the full REST3D_CPU_OFFLOAD in one crucial way: it does NOT load models
+    into system RAM at construction time. With REST3D_CPU_CONSTRUCT the models are built on
+    CPU and settle on the GPU, so RAM stays near the desktop baseline; this helper only puts
+    the generators in RAM transiently DURING mesh decode (freed again at the next object's
+    sample_sparse_structure). That fits the ~16GB of free RAM, whereas the full offload stacks
+    every model in RAM from load time and OS-OOM-kills this 30GB box. Freeing the generators'
+    ~5.4GB of VRAM leaves ample room for the dense mesh-extraction grid on a 12GB card.
+    No-op when the var is unset.
+    """
+    if os.environ.get("REST3D_OFFLOAD_EMBEDDER") != "1":
+        return
+    target = (getattr(pipeline, "device", "cuda") if to_gpu else "cpu")
+    mods = []
+    # Big idle-at-decode modules: the generators (done once sampling finishes) and ss_encoder
+    # (never used on the sampling inference path). These are the ~5.4GB that must leave the GPU.
+    models = getattr(pipeline, "models", None)
+    if models is not None:
+        for _name in ("ss_generator", "slat_generator", "ss_encoder"):
+            _m = models[_name] if _name in models else None
+            if _m is not None:
+                mods.append(_m)
+    embedders = getattr(pipeline, "condition_embedders", None)
+    if isinstance(embedders, dict):
+        mods.extend(embedders.values())
+    elif embedders is not None:
+        mods.append(embedders)
+    pose_decoder = getattr(pipeline, "pose_decoder", None)
+    if pose_decoder is not None:
+        mods.append(pose_decoder)
+    moved = []
+    for module in mods:
+        if module is None or not hasattr(module, "parameters"):
+            continue
+        param = next(module.parameters(), None)
+        if param is None:
+            continue
+        if (param.device.type == "cuda") != to_gpu:
+            module.to(target)
+            moved.append(type(module).__name__)
+    if moved:
+        torch.cuda.empty_cache()
+        logger.info(f"[REST3D aux] ->{'GPU' if to_gpu else 'CPU'} {moved}")
+
+
